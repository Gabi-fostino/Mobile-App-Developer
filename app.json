{
  "expo": {
    "name": "Train Storyteller",
    "slug": "train-storyteller",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "trainstoryteller",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trainstoryteller.app"
    },
    "android": {
      "package": "com.trainstoryteller.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
